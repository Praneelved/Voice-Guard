# ============================================
# VoiceGuard API — Environment Variables
# ============================================
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================

# --- Deployment ---
ENV=production

# --- Supabase / PostgreSQL (hosted — NOT in Docker) ---
DATABASE_URL=postgresql+asyncpg://user:password@your-supabase-host:5432/postgres
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Redis ---
# When running locally (no Docker): redis://localhost:6379
# When running inside Docker Compose: redis://redis:6379  (set by compose.yaml)
REDIS_URL=redis://localhost:6379

# --- Twilio ---
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
PROVIDER_ACCOUNT_ID=${TWILIO_ACCOUNT_SID}
PROVIDER_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
PROVIDER_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}

# --- Public URL (for Twilio webhook callbacks) ---
BASE_URL=https://your-public-url.ngrok.app

# --- AI Models ---
# Provider: "aasist" for real inference, "mock" for development without weights
ANTISPOOF_PROVIDER=aasist
# Path to AASIST model weights directory
# Local dev: ./models/aasist_weights
# Docker:    /app/model_weights/aasist  (set by compose.yaml)
AASIST_MODEL_PATH=./models/aasist_weights
# Device: "auto", "cpu", "cuda", "mps"
AI_DEVICE=auto

# --- SpeechBrain (ECAPA-TDNN speaker verification) ---
# Local dev: tmp_ecapa_models
# Docker:    /app/model_weights/speechbrain  (set by compose.yaml)
SPEECHBRAIN_CACHE_DIR=tmp_ecapa_models
