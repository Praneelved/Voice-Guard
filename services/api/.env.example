# Twilio Configuration
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# These are mapped internally, no need to change
PROVIDER_ACCOUNT_ID=${TWILIO_ACCOUNT_SID}
PROVIDER_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
PROVIDER_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}

# Public URL exposed via Ngrok (used for Twilio Webhooks)
BASE_URL=https://your-ngrok-url.ngrok-free.app

# PostgreSQL / Supabase Connection String (asyncpg dialect required)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres
