# ============================================
# VoiceGuard — Root Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# This file is referenced by docker compose.
# ============================================

# --- Deployment Mode ---
ENV=production
# ENV=development

# --- Ports ---
API_PORT=8000
REDIS_PORT=6379

# --- Model Weights ---
# Absolute or relative path on the HOST where model weights live.
# This directory is mounted read-only into the API container.
# Structure:
#   model_weights/
#     aasist/          ← AASIST anti-spoof weights
#     speechbrain/     ← ECAPA-TDNN speaker verification cache
MODEL_WEIGHTS_DIR=./model_weights
